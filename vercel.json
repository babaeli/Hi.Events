{
  "buildCommand": "cd frontend && yarn install --prod false && yarn build",
  "outputDirectory": "frontend/dist/client",
  "framework": "vite",
  "env": {
    "VITE_API_URL_CLIENT": "https://hi-events-ten.vercel.app/api",
    "VITE_API_URL_SERVER": "http://localhost:3000/api",
    "VITE_FRONTEND_URL": "https://hi-events-ten.vercel.app",
    "APP_URL": "https://hi-events-ten.vercel.app",
    "APP_FRONTEND_URL": "https://hi-events-ten.vercel.app",
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key",
    "JWT_SECRET": "@jwt_secret"
  }
}
